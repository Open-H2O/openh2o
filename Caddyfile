# Entry point for both local dev (plain HTTP on LAN) and the Cloudflare Tunnel.
# TLS is terminated at the Cloudflare edge; the tunnel forwards plain HTTP here,
# so we assert X-Forwarded-Proto=https to the app. Django's production settings
# trust that header (SECURE_PROXY_SSL_HEADER); without it SECURE_SSL_REDIRECT
# would bounce every request to https and loop through the tunnel forever.
:80 {
    encode gzip

    # Content-Security-Policy — the one security header Django's SecurityMiddleware
    # does not set. Django 5 gives us HSTS, X-Frame-Options, X-Content-Type-Options
    # and Referrer-Policy from config/settings/production.py; CSP has no built-in
    # setting there, so it lives here rather than pulling in django-csp for one line.
    # Set at site level so it covers static files and app responses alike.
    #
    # Every origin below is one this platform actually loads (verified against the
    # templates and a live page fetch, 2026-08-03). Keep this list in step with what
    # base.html and static/js/map-core.js reference — a CSP that silently drifts out
    # of date breaks the map rather than protecting anything:
    #
    #   unpkg.com          HTMX and MapLibre GL (JS + CSS) — see "No Node.js" in CLAUDE.md
    #   cdn.jsdelivr.net   Chart.js
    #   fonts.googleapis   Public Sans stylesheet; fonts.gstatic.com serves the files
    #   tiles.openfreemap  basemap tiles, sprites and glyphs (map-core.js)
    #   server.arcgisonline satellite imagery and the boundaries/places overlay
    #   analytics.vanderdev.net  Umami, and ONLY when UMAMI_WEBSITE_ID is set. Running
    #                      your own instance with a different analytics host? Change
    #                      this origin to yours, or the tag is blocked silently.
    #
    # 'unsafe-inline' is deliberate, not an oversight: 29 templates carry inline
    # <script> blocks (the diagnostics buffer in base.html loads first by design) and
    # inline style attributes are used throughout. Moving to nonces means touching
    # every one of them — worth doing, but it is a refactor, not a header change.
    #
    # worker-src/child-src blob: is what MapLibre GL needs. It spawns its tile workers
    # from blob URLs, and without these two the map fails to render at all while every
    # other page looks perfectly fine — the classic way this header gets shipped broken.
    #
    # The CDNs appear in connect-src as well as script-src because the browser fetches
    # their .js.map source maps over that directive. Only devtools triggers it, so the
    # site works either way — but leaving it blocked means anyone who opens devtools on
    # a page here is greeted by a red CSP error that has nothing to do with their bug.
    header {
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdn.jsdelivr.net https://analytics.vanderdev.net; style-src 'self' 'unsafe-inline' https://unpkg.com https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://tiles.openfreemap.org https://server.arcgisonline.com; connect-src 'self' https://unpkg.com https://cdn.jsdelivr.net https://tiles.openfreemap.org https://server.arcgisonline.com https://analytics.vanderdev.net; worker-src 'self' blob:; child-src 'self' blob:"
    }

    # Serve static files directly
    handle /static/* {
        header Cache-Control "public, max-age=0, must-revalidate"
        root * /srv
        file_server
    }

    # Proxy everything else to Django
    handle {
        reverse_proxy web:8000 {
            header_up X-Forwarded-Proto https
            # Ride out a brief web outage (nightly DB reset, a manual or
            # deploy-time restart) instead of 502-ing the visitor: retry the
            # upstream until it answers, so a request that arrives mid-restart
            # waits for web to come back rather than failing.
            #
            # This is a CEILING, not a fixed wait: lb_try_interval retries every
            # 250 ms and the request completes the instant web is listening
            # again, so raising it costs a healthy visitor nothing.
            #
            # It must exceed how long `web` is actually stopped, or the retry
            # budget runs out mid-outage and the visitor gets a 502 anyway.
            # `scripts/reset-demo.sh` does `docker compose stop web`, restores
            # the golden dump, then starts web. Measured from the container's
            # own gunicorn term/start log lines (2026-07-31):
            #     nightly reset 03:15  ->  13.1 s stopped
            #     v2.7 deploy   20:20  ->  14.0 s stopped
            # At the previous 10 s a request landing in the first ~3 s of the
            # window exhausted the budget and 502'd. 30 s leaves roughly a 2x
            # margin over the measured worst case; re-measure before lowering.
            lb_try_duration 30s
            lb_try_interval 250ms
        }
    }

    # Branded page for a REAL outage — reached only when the retry budget above
    # is exhausted, i.e. web has been unreachable for 30 s+. The nightly demo
    # reset finishes well inside that budget, so this never shows for it.
    #
    # This does NOT intercept Django's own 404s and 500s: handle_errors fires on
    # errors CADDY produces (a reverse_proxy that could not get a response). A
    # 404 rendered BY the app is a successful proxy and passes straight through,
    # so the app keeps owning its own error pages.
    handle_errors {
        root * /srv/error
        rewrite * /503.html
        file_server
        header Cache-Control "no-store"
        # Tell crawlers and uptime checks this is temporary, not the new truth.
        header Retry-After "30"
    }
}

# Production config (uncomment and replace domain):
