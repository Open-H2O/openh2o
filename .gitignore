# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Environment
.env

# Secrets (Earth Engine service-account key, etc.) — never commit key material.
# Keep the directory tracked (for the docker key mount) but ignore its contents.
/secrets/*
!/secrets/.gitkeep

# Docker volumes
db_data/
caddy_data/
caddy_config/

# Static files (collected/compiled)
staticfiles/
static/css/output.css

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Tailwind binary
tailwindcss-*

# Media (user-uploaded / generated reports)
media/
.claude/

# Production guard marker — present only in the live deployment checkout, never
# committed. The Makefile's destructive targets refuse to run when this exists.
.production-lock

# Demonstration-host opt-in marker — the OPPOSITE claim to .production-lock, and
# present only on the maintainer's public demo checkout, never committed.
# `make deploy` replaces the live database with the demonstration snapshot, so it
# refuses to run unless this file says the database here is disposable.
.demo-host

# Internal planning / build scaffolding (not for public repo)
.planning/
.env.*
*.bak
*.bak.*
static/img/logo-alternatives/

# Written by `make ci-gate`: the commit the last gate run found green.
.deploy-verified-sha

# A maintainer's own agent notes, never published.
CLAUDE.local.md

# Nightly backups (scripts/backup.sh): database dumps and uploaded files, never committed.
# The folder itself ships (backups/.gitkeep) so the clone's own user owns it: on a Linux
# server Docker creates a missing bind-mount folder owned by root, and the backup could
# then never write there.
backups/*
!backups/.gitkeep

# Written by scripts/restore.sh while a restore runs; the scheduled sync and backup skip while it exists.
.restore-in-progress
