# Open Water Accounting Platform - Environment Variables
#
# Copy this file to .env and fill in values:
#   cp .env.example .env
#
# Generate a secret key:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Django secret key (REQUIRED - generate a unique value, never commit it)
SECRET_KEY=change-me-generate-with-python3-c-import-secrets-print-secrets.token_urlsafe-50

# ---------------------------------------------------------------------------
# Database (defaults work for Docker Compose)
# ---------------------------------------------------------------------------

POSTGRES_DB=openh2o
POSTGRES_USER=openh2o
POSTGRES_PASSWORD=openh2o

# Override if connecting to an external database. Default connects to the
# Docker Compose db service:
# DATABASE_URL=postgis://openh2o:openh2o@db:5432/openh2o

# ---------------------------------------------------------------------------
# Django Settings Module
# ---------------------------------------------------------------------------

# For production (default — fail closed; needs a strong DB password +
# real ALLOWED_HOSTS, so a mis-copied deploy stops loudly, not in DEBUG):
DJANGO_SETTINGS_MODULE=config.settings.production

# For local development (uncomment, or run via make/pytest which pin --ds):
# DJANGO_SETTINGS_MODULE=config.settings.local

# ---------------------------------------------------------------------------
# Production Security (required when DJANGO_SETTINGS_MODULE=production)
# ---------------------------------------------------------------------------

# Comma-separated list of hostnames Django will serve
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated HTTPS origins trusted for CSRF (include https://)
# CSRF_TRUSTED_ORIGINS=https://water.example.org

# The address Caddy answers at. Blank means port 80 at any address; a bare
# domain such as water.example.org gets its own certificate (DEPLOY.md section 4).
# OPENH2O_SITE_ADDRESS=

# On a site without HTTPS, set all three to False (DEPLOY.md, Branch A):
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# True keeps the administrator screens for administrators and closes public
# sign-up. Set False only on an open demonstration site where anyone may sign up.
# ACCESS_CONTROL_ENFORCED=True

# Creates the first host administrator when the site has none:
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=
# DJANGO_SUPERUSER_USERNAME=   # defaults to the email address

# Folder for the error log. Inside Docker it is on the logs volume; a site
# installed without Docker sets a folder its own account can write to.
# LOG_DIR=/app/logs

# Where the Source code link at the foot of every page points. An organization
# that changes OpenH2O's code and runs it for its users sets this to where it
# publishes its changes (the AGPL, section 13; see NOTICE).
# SOURCE_CODE_URL=https://github.com/Open-H2O/openh2o

# ---------------------------------------------------------------------------
# Timezone
# ---------------------------------------------------------------------------

TIME_ZONE=America/Los_Angeles

# ---------------------------------------------------------------------------
# Email (optional, defaults to console output in development)
# ---------------------------------------------------------------------------

# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=noreply@your-domain.com
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# Whether a new signup must confirm its email address before it can log in.
# Values: none | optional | mandatory. Leave BLANK to derive it from EMAIL_HOST
# above: mandatory when a mail server is configured, none when there is not one,
# so an install that cannot send mail never locks out its own operator.
# Set it explicitly to override (an open demo with SMTP configured wants none).
ACCOUNT_EMAIL_VERIFICATION=

# ---------------------------------------------------------------------------
# Google OAuth (optional, enables "Sign in with Google")
# ---------------------------------------------------------------------------

# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# External Data Sync
# ---------------------------------------------------------------------------

# Set to True to use canned mock data instead of live public-API calls
# (no network on seed/sync). Default False = real data, matching the demo.
DATASYNC_MOCK_MODE=False

# ---------------------------------------------------------------------------
# OpenET data source
# ---------------------------------------------------------------------------

# OpenET REST API key (used when OPENET_MODE=api). Get one at https://etdata.org
# OPENET_API_KEY=
# OPENET_CACHE_DAYS=30
# OPENET_MONTHLY_BUDGET=100   # requests a month; 100 is the default

# Which faucet OpenH2O uses for ET data:
#   api (default) = OpenET REST API, using OPENET_API_KEY above.
#   gee           = pull the SAME OpenET data from Google Earth Engine
#                   (large districts). Only set the GEE_* vars if you switch.
#                   Setup + honest cost guide: docs/earth-engine-tier-setup.md
OPENET_MODE=api
GEE_PROJECT=
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_SERVICE_ACCOUNT_KEY_FILE=/run/secrets/gee-key.json
# -- Modules -----------------------------------------------------------------
# Which OpenH2O domains this deployment runs. Comma-separated. Left blank, every
# module runs except reporting; "all" runs every module.
# Omitting a module means its tables are never migrated and its nav never
# renders. core, geography, measurements and standards cannot be omitted.
# A typo or an unmet dependency fails loudly at startup, never silently.
# OPENH2O_MODULES=core,geography,parcels,wells,measurements,standards,accounting,surface,recharge,datasync,reporting,health,setup,infrastructure,feedback

# --- Optional data-source keys (sources ship deactivated until you enable them) ---
# CIMIS_API_KEY=            # free key from cimis.water.ca.gov — needed to enable the CIMIS source
# NOAA_CDO_TOKEN=           # free token from ncdc.noaa.gov/cdo-web/token — raises NOAA rate limits
# USGS_API_KEY=             # optional: a free key from api.waterdata.usgs.gov/signup raises how many requests an hour USGS accepts

# --- Optional in-app feedback widget (off by default; see DEPLOY.md §12) ---
# FEEDBACK_ENABLED=False
# FEEDBACK_ENDPOINT=        # optional: an address each stored report is also sent to; blank keeps reports on this site only

# --- Optional operations notifications ---
# OPENH2O_NTFY_URL=         # an ntfy topic address; the scheduled jobs and make deploy send failure alerts to it
